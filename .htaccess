# =========================================================
# OLDORA - MAX SECURITY (ALL IMAGES ALLOWED)
# =========================================================

# ---------------------------
# 1) Hide server info
# ---------------------------
Header unset X-Powered-By
ServerSignature Off

# ---------------------------
# 2) Block bad bots & scanners
# ---------------------------
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|acunetix|fimap|wpscan|dirbuster|masscan|havij) [NC]
RewriteRule ^.* - [F,L]
</IfModule>

# ---------------------------
# 3) Force HTTPS and keep the canonical non-WWW host.
# 308 preserves POST bodies used by payment and API webhooks.
# ---------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.oldora\.vip$ [NC]
RewriteRule ^ https://oldora.vip%{REQUEST_URI} [L,R=308,NE]

# ---------------------------
# 4) Custom Error Pages
# ---------------------------
ErrorDocument 400 /errors/400.php
ErrorDocument 401 /errors/401.php
ErrorDocument 403 /errors/403.php
ErrorDocument 404 /404.php
ErrorDocument 405 /errors/405.php
ErrorDocument 408 /errors/408.php
ErrorDocument 410 /errors/410.php
ErrorDocument 413 /errors/413.php
ErrorDocument 415 /errors/415.php
ErrorDocument 429 /errors/429.php
ErrorDocument 500 /errors/500.php
ErrorDocument 502 /errors/502.php
ErrorDocument 503 /errors/503.php
ErrorDocument 504 /errors/504.php

# ---------------------------
# 5) Block sensitive files
# ---------------------------
<FilesMatch "^(\.env|\.htaccess|\.user\.ini|composer\.(json|lock)|phpunit\.xml|\.git|\.gitignore|\.svn|\.DS_Store)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(bak|backup|old|orig|save|swp|sql|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# ---------------------------
# 6) Disable directory listing
# ---------------------------
Options -Indexes

# ---------------------------
# 7) Security Headers (IMAGES FULLY UNLOCKED)
# ---------------------------
<IfModule mod_headers.c>
# حماية أساسية للمتصفح
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

# --- تم حذف Cross-Origin Policies لأنها تحجب الصور الخارجية ---

# --- CSP: تم السماح لجميع الصور (*) ---
# img-src * data: blob: تعني اسمح للصور من أي مكان في العالم
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://ajax.googleapis.com https://code.jquery.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com; img-src * data: blob:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https:; upgrade-insecure-requests;"

Header always set Feature-Policy "accelerometer 'none'; camera 'none'; microphone 'none'; geolocation 'none'; payment 'none'; usb 'none';"
Header set Connection keep-alive
</IfModule>

# ---------------------------
# 8) Block XMLRPC (WordPress)
# ---------------------------
<Files xmlrpc.php>
Require all denied
</Files>

# ---------------------------
# 9) Cache static files
# ---------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png  "access plus 1 year"
ExpiresByType image/jpg  "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType application/json "access plus 1 week"
</IfModule>

# ---------------------------
# 10) GZIP Compression
# ---------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain text/html text/css text/xml application/javascript application/json application/xml
</IfModule>

# ---------------------------
# 11) Block common attacks (XSS/SQLi/LFI)
# ---------------------------
<IfModule mod_rewrite.c>
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} union.*select.*\( [NC,OR]
RewriteCond %{QUERY_STRING} base64_encode.*\( [NC,OR]
RewriteCond %{QUERY_STRING} (\.\./|\.\.) [NC,OR]
RewriteCond %{QUERY_STRING} etc/passwd [NC,OR]
RewriteCond %{QUERY_STRING} boot\.ini [NC]
RewriteRule .* - [F,L]
</IfModule>

# ---------------------------
# 12) Block hacking tools & scanners
# ---------------------------
<IfModule mod_rewrite.c>
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|acunetix|fimap|havij|wpscan) [NC]
RewriteRule .* - [F,L]
</IfModule>

# =========================================================
# END MAX SECURITY
# =========================================================
